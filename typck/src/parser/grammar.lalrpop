use lalrpop_util::ParseError;

use crate::ast::*;
use super::*;

grammar;

extern {
    type Error = anyhow::Error;
}

// Lexer
match {
    r"//[^\n]*" => { }, // Skip comments
    r"/\*.*\*/" => { }, // Skip comments
    r"[ \t\r\n]+" => { }, // Skip whitespace
} else {
    ",",
    ";",
    "(",
    ")",
    "{",
    "}",
    "=",
    ":",
    "->",
    "=>",
    "|",
    "<|",
    "|>",
    "[",
    "]",
    "<",
    "<=",
    ">",
    ">=",
    "==",
    "!=",
    "+",
    "-",
    "*",
    "/",
    ".",
    "List::head",
    "List::isempty",
    "List::tail",
    "Nat::pred",
    "Nat::iszero",
    "Nat::rec",
    "Bool",
    "Nat",
    "Unit",
    "and",
    "as",
    "cons",
    "core",
    "else",
    "extend",
    "false",
    "fix",
    "fn",
    "fold",
    "if",
    "in",
    "inl",
    "inline",
    "inr",
    "language",
    "let",
    "letrec",
    "match",
    "not",
    "or",
    "return",
    "succ",
    "then",
    "throws",
    "true",
    "type",
    "unfold",
    "unit",
    "with",
    "µ",
    "exception",
    "variant",
    "cast",
    ":=",
    "&",
    "new",
    "panic!",
    "throw",
    "try",
    "catch",
    "Top",
    "Bot",
    "auto",
    "generic",
    "forall",
} else {
    r"#([\-_0-9A-Za-z])+" => EXTENSION,
    r"<0x[0-9a-fA-F]+>" => ADDRESS,
    r"[_a-zA-Z][_a-zA-Z0-9!\-:?_]*" => IDENT,
}

SepWith1<Sep, T>: Vec<T> = {
    <mut v:(<T> Sep)*> <e:T> => {
        v.push(e);
        v
    }
}

SepWith0<Sep, T>: Vec<T> = {
    <mut v:(<T> Sep)*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
}

Box<T>: Box<T> = T => Box::new(<>);

// Parser
pub(in crate::parser) Program: Program<'input> = {
    LanguageDecl <extensions: FlattenExtensions> <decls: Decl*> => Program { <> }
}

// HACK: this is a bit inefficient, collecting to BTreeSet directly would be better
FlattenExtensions: BTreeSet<&'input str> = ExtendWith* => flatten(<>);

ExtendWith = "extend" "with" <SepWith1<",", EXTENSION>> ";";

LanguageDecl = "language" "core" ";" ;

FnParams: Vec<(Ident<'input>, Type<'input>)> = SepWith0<",", (<Ident> ":" <Type>)>;

Decl: Decl<'input> = {
    <annotations: Annotation*> "fn" <name: Ident>
        "(" <params: FnParams> ")"
        <ret_ty: ReturnType> <throws: ThrowsTy>
        "{" <decls: Decl*> "return" <ret: Expr> "}"
        => Decl::Function { generics: vec![], <> },
    <annotations: Annotation*> "generic" "fn" <name: Ident>
        "[" <generics: SepWith0<",", Ident>> "]"
        "(" <params: FnParams> ")"
        <ret_ty: ReturnType> <throws: ThrowsTy>
        "{" <decls: Decl*> "return" <ret: Expr> "}"
        => Decl::Function { <> },
    "type" <name: Ident> "=" <ty: Type> => Decl::TypeAlias { <> },
    "exception" "type" "=" <Type> => Decl::ExceptionType(<>),
    "exception" "variant" <name: Ident> ":" <ty: Type> => Decl::ExceptionVariant { <> },
}

ReturnType: Option<Type<'input>> = ("->" <Type>)?;

ThrowsTy: Vec<Type<'input>> = ("throws" <SepWith1<",", Type>>)? => (<>).unwrap_or_default();

Annotation: Annotation = {
    "inline" => Annotation::Inline,
}

Ident: Ident<'input> = IDENT => (<>).into();

Type: Type<'input> = {
    "auto" => Type::Auto,
    "fn" "(" <args: SepWith0<",", Type>> ")" "->" <ret: Box<Type>> => Type::Fn { <> },
    "forall" <binders: Ident*> "." <ty: Box<Type>> => Type::Forall { <> },
    "µ" <var: Ident> "." <ty: Box<Type>> => Type::Rec { <> },
    Type1
}

Type1: Type<'input> = {
    <left: Box<Type2>> "+" <right: Box<Type2>> => Type::Sum { <> },
    Type2
}

Type2: Type<'input> = {
    "{" <SepWith0<",", Type>> "}" => Type::Tuple(<>),
    "{" <SepWith1<",", (<Ident> ":" <Type>)>> "}" => Type::Record(<>),
    "<|" <SepWith0<",", (Ident (":" <Type>)?)>> "|>" => Type::Variant(<>),
    "[" <Box<Type>> "]" => Type::List(<>),
    Type3
}

Type3: Type<'input> = {
    "Bool" => Type::Bool,
    "Nat" => Type::Nat,
    "Unit" => Type::Unit,
    "Top" => Type::Top,
    "Bot" => Type::Bot,
    "&" <Box<Type2>> => Type::Ref(<>),
    Ident => Type::Var(<>),
    "(" <Type> ")",
}

Expr: Expr<'input> = {
    Ident => Expr::Var(<>),
}
